PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/reclaimit?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
DISABLE_RATE_LIMIT=true
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads
# Image storage: local (default) or cloudinary
STORAGE_DRIVER=local
# Cloudinary (required when STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# CLOUDINARY_FOLDER=reclaimit/items
# CLIENT_URL is used in QR codes — scanners open {CLIENT_URL}/items/:id

# Email (Nodemailer) — Gmail: use an App Password, not your login password
EMAIL=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
# PASSWORD=your_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_FROM="ReclaimIt <your_email@gmail.com>"
